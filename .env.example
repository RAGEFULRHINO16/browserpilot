# Generate independent, random secrets. Never commit the filled .env.local file.
BROWSERPILOT_COMPANION_TOKEN=
BROWSERPILOT_COMPANION_URL=http://127.0.0.1:8765
BROWSERPILOT_DOWNLOAD_DIR=
BROWSERPILOT_UPLOAD_DIR=
# CLI setup creates a private config in your OS user data directory.
# These environment variables override that config when needed.
BROWSERPILOT_BROWSER_BACKEND=extension

# Optional local HTTP MCP transport uses this independent bearer token.
# The public release rejects public hosts and has no anonymous HTTP mode.
BROWSERPILOT_MCP_TOKEN=
